<div class="modal__overlayer"></div>
<div class="modal__content">
  <header class="modal__header">
    <button class="modal__close btn-close icon-x" type="button" {{action onClose}}></button>
    <h3 class="modal__title">Unidades e objetos de aprendizagem — <span>{{modulo.name}}</span></h3>
  </header>

  <div class="modal__body">
    <div class="flex flex-col flow-md">

      <nav>
        <ul class="tabs">
          {{#each atividades as |atividade idx|}}
          <li>
            <button type="button" class="tabs__tab {{if (equalstr atividade atividadeAtiva) 'tabs__tab--is-active'}}" {{action 'selectAtividade' atividade}}>
              <span>{{if atividade.titulo atividade.titulo (concat 'Unidade ' (addone idx))}}</span>
            </button>
          </li>
          {{/each}}
          <li>
            <button type="button" class="tabs__tab" {{action 'addAtividade'}}>
              <span>+ Nova unidade</span>
            </button>
          </li>
        </ul>
      </nav>

      {{#if atividadeAtiva}}
      <div class="flex flex-col flow-md">
        <div class="form-group w100">
          <label class="form-group__label" for="moduloAtividadeTitulo">Título da unidade</label>
          {{input class="form-group__input" id="moduloAtividadeTitulo" value=atividadeAtiva.titulo placeholder="Título da unidade" maxlength=80}}
        </div>
        <div class="form-group w100">
          <label class="form-group__label" for="moduloAtividadeDescricao">Descrição da unidade</label>
          {{textarea class="form-group-descricao" id="moduloAtividadeDescricao" rows="4" value=atividadeAtiva.descricao placeholder="Descrição da unidade" maxlength=500}}
        </div>
        <button class="btn btn--text btn--xxs color-error-40 self-start" type="button" {{action 'removeAtividade' atividadeAtiva}}>
          <span class="btn__label">Remover unidade</span>
        </button>

        <h4 class="modal__subtitle">Objetos de aprendizagem</h4>
        <div class="two-col-wrap">
          {{#each atividadeAtiva.secoes as |secao idx|}}
          <button type="button" class="btn btn__filter-content btn--xxs {{if (equalstr secao atividadeAtiva.secaoAtiva) 'btn--is-active'}}" {{action 'selectSecao' atividadeAtiva secao}}>
            <span class="btn__label">{{if secao.titulo secao.titulo (concat 'Objeto de aprendizagem ' (addone idx))}}</span>
          </button>
          {{/each}}
          <button type="button" class="btn btn--text btn--xxs" {{action 'addSecao' atividadeAtiva}}>
            <span class="btn__label">+ Novo objeto de aprendizagem</span>
          </button>
        </div>

        {{#if atividadeAtiva.secaoAtiva}}
        <div class="flex flex-col flow-md">
          <div class="form-group w100">
            <label class="form-group__label" for="moduloSecaoTitulo">Título do objeto de aprendizagem</label>
            {{input class="form-group__input" id="moduloSecaoTitulo" value=atividadeAtiva.secaoAtiva.titulo placeholder="Título do objeto de aprendizagem" maxlength=80}}
          </div>
          <div class="form-group w100">
            <label class="form-group__label" for="moduloSecaoTipo">Tipo do objeto de aprendizagem</label>
            <div class="form-group__wrapper form-group__wrapper--select">
              <select class="form-group__input" id="moduloSecaoTipo"
                onchange={{action 'selectTipoSecao' atividadeAtiva.secaoAtiva}}>
                <option value="" disabled selected={{if atividadeAtiva.secaoAtiva.tipo false true}}>Selecione o tipo</option>
                {{#each tiposSecao as |tipo|}}
                <option value={{tipo.valor}} selected={{if (equalstr tipo.valor atividadeAtiva.secaoAtiva.tipo) true false}}>{{tipo.nome}}</option>
                {{/each}}
                {{#if atividadeAtiva.secaoAtiva.tipoDescontinuado}}
                <option value="questoes" selected>Questões (descontinuado)</option>
                {{/if}}
              </select>
            </div>
            {{#if atividadeAtiva.secaoAtiva.tipoDescontinuado}}
            <p class="color-error-40" style="line-height: 1.4; margin-top: 4px; font-size: 0.85em;">Tipo descontinuado. Remova este objeto de aprendizagem ou troque o tipo.</p>
            {{/if}}
          </div>

          {{#if (equalstr atividadeAtiva.secaoAtiva.tipo 'arquivo')}}
          <div class="form-group w100">
            <label class="form-group__label" for="moduloSecaoDescricao">Descrição</label>
            {{textarea class="form-group-descricao" id="moduloSecaoDescricao" rows="4" value=atividadeAtiva.secaoAtiva.descricao placeholder="Descrição do objeto de aprendizagem" maxlength=500}}
          </div>
          {{/if}}

          {{#if (equalstr atividadeAtiva.secaoAtiva.tipo 'texto')}}
          <div class="form-group w100">
            <label class="form-group__label" for="moduloSecaoTexto">Texto</label>
            {{textarea class="form-group-descricao" id="moduloSecaoTexto" rows="10" value=atividadeAtiva.secaoAtiva.descricao placeholder="Texto do objeto de aprendizagem. Aceita texto simples (quebras de linha viram parágrafos) ou HTML simples (p, b, i, u, listas, links, h2–h4, img)." aria-describedby="moduloSecaoTexto-dica"}}
            <p id="moduloSecaoTexto-dica" style="line-height: 1.4; margin-top: 4px; font-size: 0.85em;">Pode ser texto simples (cada quebra de linha vira um parágrafo) ou HTML simples: p, b, i, u, listas, links, h2 a h4 e img. Outras tags são removidas ao salvar.</p>
          </div>
          {{/if}}

          {{#if (equalstr atividadeAtiva.secaoAtiva.tipo 'arquivo')}}
          <div class="flex flex-col flow-xs">
            {{#each atividadeAtiva.secaoAtiva.botoes as |botao idx|}}
            <div class="row">
              <div class="col-xs-12 col-sm-4">
                <div class="form-group w100">
                  <label class="form-group__label" for="moduloSecaoBotaoTitulo{{idx}}">Título do botão {{addone idx}}</label>
                  {{input class="form-group__input" id=(concat 'moduloSecaoBotaoTitulo' idx) value=botao.titulo placeholder="Ex.: Baixar, Abrir" maxlength=40}}
                </div>
              </div>
              <div class="col-xs-12 col-sm-8">
                <div class="form-group w100">
                  <label class="form-group__label" for="moduloSecaoBotaoLink{{idx}}">Link do botão {{addone idx}}</label>
                  {{input class="form-group__input" id=(concat 'moduloSecaoBotaoLink' idx) type="url" value=botao.link placeholder="https://"}}
                </div>
              </div>
            </div>
            {{/each}}
          </div>
          {{/if}}

          {{#if (equalstr atividadeAtiva.secaoAtiva.tipo 'video')}}
          <div class="form-group w100">
            <label class="form-group__label" for="moduloSecaoVideoId">Vídeo (id/URL do Vimeo ou URL do YouTube)</label>
            <input class="form-group__input" id="moduloSecaoVideoId" type="text"
              value={{atividadeAtiva.secaoAtiva.videoId}}
              oninput={{action (mut atividadeAtiva.secaoAtiva.videoId) value="target.value"}}
              placeholder="Ex.: 123456789, vimeo.com/123456789 ou youtube.com/watch?v=…"
              autocomplete="off" data-lpignore="true" data-1p-ignore="true" data-bwignore="true" data-form-type="other"
              aria-describedby="moduloSecaoVideoId-provedor">
            <p id="moduloSecaoVideoId-provedor" class="fw--3" style="line-height: 1.4; margin-top: 4px; font-size: 0.85em;">
              {{#if atividadeAtiva.secaoAtiva.provedorNome}}Provedor detectado: {{atividadeAtiva.secaoAtiva.provedorNome}}{{else}}Cole o id ou a URL do vídeo; o provedor é detectado automaticamente.{{/if}}
            </p>
          </div>
          {{/if}}

          {{#if atividadeAtiva.secaoAtiva.tipoDescontinuado}}
          <p class="color-error-40">Objetos de aprendizagem do tipo questões foram descontinuados e não são mais oferecidos no cadastro. Remova este objeto de aprendizagem ou troque o tipo acima.</p>
          {{/if}}

          <button class="btn btn--text btn--xxs color-error-40 self-start" type="button" {{action 'removeSecao' atividadeAtiva atividadeAtiva.secaoAtiva}}>
            <span class="btn__label">Remover objeto de aprendizagem</span>
          </button>
        </div>
        {{else}}
        <p>Nenhum objeto de aprendizagem. Clique em "+ Novo objeto de aprendizagem" para adicionar.</p>
        {{/if}}
      </div>
      {{else}}
      <p>Nenhuma unidade. Clique em "+ Nova unidade" para adicionar.</p>
      {{/if}}

    </div>
  </div>

  <footer class="modal__footer">
    {{#if erro}}
      <p class="color-error-40 self-center">{{erro}}</p>
    {{/if}}
    <button class="btn btn--text" type="button" {{action onClose}}>Cancelar</button>
    <button class="btn" type="button" disabled={{salvando}} {{action 'save'}}>{{if salvando 'Salvando...' 'Salvar'}}</button>
  </footer>
</div>
